def ダメージ計算():
    # 基礎値と倍率スキル
    武器倍率 = 395
    攻撃Lv7倍率 = 1.1
    龍気活性倍率 = 1.1
    氷気錬成倍率 = 1.3
    アンカーレイジ倍率 = 1.15
    攻勢守勢倍率 = 1.15
    
    # 固定加算値
    攻撃Lv7加算 = 10
    死中の活 = 20
    力の護符・爪 = 15
    怪力の種・粉塵 = 15
    業鎧修羅 = 15
    
    # 最終攻撃力の計算
    最終攻撃力 = (武器倍率 * 攻撃Lv7倍率 * 龍気活性倍率 * 氷気錬成倍率 * アンカーレイジ倍率 * 攻勢守勢倍率) \
               + 攻撃Lv7加算 + 死中の活 + 力の護符・爪 + 怪力の種・粉塵 + 業鎧修羅
    
    # 斬れ味補正（紫）
    物理斬れ味 = 1.39
    属性斬れ味 = 1.27
    
    # アクション値（モーション値）と属性倍率
    モーション値 = 84 / 100
    属性補正 = 1.2
    
    # 会心（超会心Lv3）
    超会心倍率 = 1.4
    
    # 最終ダメージ（会心時）
    物理ダメージ = 最終攻撃力 * 物理斬れ味 * モーション値 * 超会心倍率
    
    # 属性ダメージ
    属性値 = 47
    属性ダメージ = 属性値 * 属性斬れ味 * 属性補正
    
    return 最終攻撃力, 物理ダメージ, 属性ダメージ

最終攻撃力, 物理ダメージ, 属性ダメージ = ダメージ計算()

print(f"{最終攻撃力=:.2f}")
print(f"{物理ダメージ=:.2f}")
print(f"{属性ダメージ=:.2f}")
